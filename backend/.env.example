# Puerto del servidor
PORT=3000
NODE_ENV=development

# Conexión a Base de Datos (PostgreSQL o MySQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/plastic_factory_db?schema=public"

# JWT Secret & Expiration
JWT_SECRET="super-secret-jwt-key-for-plastics-erp"
JWT_EXPIRES_IN="7d"

# Worker local de visión EPP (OpenCV DNN + modelo ONNX; sin API key externa)
PPE_INFERENCE_URL="http://127.0.0.1:8010/infer"
