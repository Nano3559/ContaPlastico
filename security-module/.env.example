# Red donde DroidCam está disponible
DROIDCAM_URL=http://192.168.0.34:4747/video
YOLO_MODEL=yolov8n.pt

# Hardware y persistencia se mantienen apagados por defecto
ARDUINO_PORT=COM3
ARDUINO_BAUD=9600
ENABLE_ARDUINO=false
ENABLE_DATABASE=false

# Al habilitar ENABLE_DATABASE, el monitor reutiliza DATABASE_URL desde
# security-module/.env o backend/.env. No copies ni publiques credenciales.
